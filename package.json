    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "~5.8.3",
    "wrangler": "^4.158.0"
  }
}
